PORT=4000
NODE_ENV=development
# Neon connection pooling endpoint (use pooler hostname)
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]-pooler.[REGION].aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Neon direct endpoint (for migrations and CLI commands)
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[HOST].[REGION].aws.neon.tech/neondb?sslmode=require&channel_binding=require"
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
GOOGLE_CLIENT_ID="your_google_oauth_client_id_here"
# Deliberately simple shared secret for emergency manual collection bypass (Admin PIN)
ADMIN_PIN="your-strong-admin-pin"

# Safety guard for running destructive development seed scripts (must be "true" to allow dev database seeding)
SEED_ALLOW_DESTRUCTIVE="false"

